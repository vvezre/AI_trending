# AI 提供商配置
# 可选值: deepseek, glm, kimi, openai, claude, gemini
AI_PROVIDER=deepseek

# 推荐使用通用 Key 变量
AI_API_KEY=your_api_key_here
AI_API_BASE=  # 可选：自定义 API URL

# 或者使用特定提供商的变量
# DEEPSEEK_API_KEY=your_key
# GLM_API_KEY=your_key
# KIMI_API_KEY=your_key
# OPENAI_API_KEY=your_key
# ANTHROPIC_API_KEY=your_key (Claude)
# GOOGLE_API_KEY=your_key (Gemini)

# 邮件配置
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECEIVER=receiver@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# GitHub Trending 配置
GITHUB_TRENDING_URL=https://github.com/trending
TRENDING_LANGUAGE=  # 留空表示所有语言，或指定如: python, rust等
TRENDING_SINCE=daily  # daily, weekly, monthly
